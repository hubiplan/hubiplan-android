<?xml version="1.0" encoding="utf-8"?>
<!-- Foto aus der Kamera (nach dem Hochladen gelöscht) und Quittungen zum Teilen (je Konto und Ausgabe eigener Ordner, aufgeräumt beim Start, nach 10 Minuten und beim Abmelden), beides nur im Cache -->
<paths>
    <cache-path name="fotos" path="fotos/" />
    <cache-path name="quittungen" path="quittungen/" />
    <!-- Export alter, nicht gesendeter Belege vor dem Löschen (Fachfrage FQ24), nach etwa einer Stunde und beim Start gelöscht -->
    <cache-path name="export" path="export/" />
    <!-- Wallet-Pass zum Öffnen in einer Wallet-App, beim nächsten Laden überschrieben, nach etwa einer Stunde gelöscht -->
    <cache-path name="ausweis" path="ausweis/" />
    <!-- Rechnung, Protokoll oder Dokument zum Ansehen (Reiter „Ich“), beim nächsten Öffnen, nach etwa einer Stunde, beim Start und beim Abmelden gelöscht -->
    <cache-path name="ansicht" path="ansicht/" />
</paths>
